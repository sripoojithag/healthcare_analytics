# ==============================================================================
# Dockerfile.frontend — Healthcare Data Warehouse React Dashboard
# Multi-stage: Node.js 20 build -> Nginx Alpine production image
# ==============================================================================

# Stage 1: Build static bundle
FROM node:20-alpine AS builder

WORKDIR /app

# Install package dependencies
COPY package*.json ./
RUN npm ci || npm install

# Copy application source and build assets
COPY index.html tsconfig*.json vite.config.ts metadata.json ./
COPY src/ ./src/

# Compile React SPA
RUN npm run build

# Stage 2: Serve via Nginx
FROM nginx:alpine AS runner

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose HTTP port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
